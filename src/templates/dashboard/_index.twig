{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Search Dashboard"|t('search-kit') %}

{# Arranging is a mode of this page, so whatever is being filtered to stays filtered to. #}
{% set filters = craft.app.request.queryParams|filter((value, key) => key != 'layout') %}
{% set here = craft.app.request.getUrl() %}

{% block actionButton %}
    {% if arranging %}
        <a href="{{ url('search-kit/dashboard', filters) }}" class="btn submit">{{ "Done"|t('search-kit') }}</a>
    {% else %}
        <a href="{{ url('search-kit/dashboard', filters|merge({ layout: 'arrange' })) }}" class="btn">{{ "Arrange panels"|t('search-kit') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% set panelNames = {
        overview: "Overview"|t('search-kit'),
        trend: "Search activity over time"|t('search-kit'),
        outcomes: "Search outcomes"|t('search-kit'),
        popular: "Most searched for"|t('search-kit'),
        zeroResults: "Queries returning no results"|t('search-kit'),
        clicked: "Most opened results"|t('search-kit'),
        unopened: "Queries nothing came of"|t('search-kit'),
        performance: "How long searches took"|t('search-kit'),
        slowQueries: "Slowest queries"|t('search-kit'),
        health: "Search health"|t('search-kit'),
    } %}

    {% set indexOptions = [{ label: "All indexes"|t('search-kit'), value: '' }] %}
    {% for indexId, indexName in indexNames %}
        {% set indexOptions = indexOptions|merge([{ label: indexName, value: indexId }]) %}
    {% endfor %}

    {% set siteOptions = [{ label: "Any site"|t('search-kit'), value: '' }] %}
    {% for siteId, siteName in siteNames %}
        {% set siteOptions = siteOptions|merge([{ label: siteName, value: siteId }]) %}
    {% endfor %}

    {% set today = now|date('Y-m-d') %}
    {% set activeFrom = criteria.dateFrom ? criteria.dateFrom|date('Y-m-d') : '' %}
    {% set activeTo = criteria.selectedDateTo ? criteria.selectedDateTo|date('Y-m-d') : '' %}
    {% set isFiltered = criteria.indexId or criteria.siteId or activeFrom or activeTo %}

    {% set ranges = [
        { label: "Last 7 days"|t('search-kit'), from: now|date_modify('-6 days')|date('Y-m-d'), to: today },
        { label: "Last 30 days"|t('search-kit'), from: now|date_modify('-29 days')|date('Y-m-d'), to: today },
        { label: "Last 90 days"|t('search-kit'), from: now|date_modify('-89 days')|date('Y-m-d'), to: today },
        { label: "All time"|t('search-kit'), from: '', to: '' },
    ] %}

    <p class="light sk-intro">{{ "How search is performing: what people looked for, what they found, and how quickly. Nothing here identifies who searched."|t('search-kit') }}</p>

    <form method="get" accept-charset="UTF-8" class="sk-filters">
        <div class="sk-field">
            <span class="sk-field-label">{{ "Index"|t('search-kit') }}</span>
            {{ forms.select({ name: 'indexId', options: indexOptions, value: criteria.indexId }) }}
        </div>

        <div class="sk-field">
            <span class="sk-field-label">
                {{ "Site"|t('search-kit') }}
                <span class="info">{{ "Counts searches of that site alone. A search covering every site is not one of them."|t('search-kit') }}</span>
            </span>
            {{ forms.select({ name: 'siteId', options: siteOptions, value: criteria.siteId }) }}
        </div>

        <div class="sk-field">
            <span class="sk-field-label">{{ "From"|t('search-kit') }}</span>
            {{ forms.date({ name: 'dateFrom', value: criteria.dateFrom }) }}
        </div>

        <div class="sk-field">
            <span class="sk-field-label">
                {{ "To"|t('search-kit') }}
                <span class="info">{{ "The whole of this day is counted."|t('search-kit') }}</span>
            </span>
            {{ forms.date({ name: 'dateTo', value: criteria.selectedDateTo }) }}
        </div>

        <div class="sk-field">
            <button type="submit" class="btn submit">{{ "Apply"|t('search-kit') }}</button>
        </div>

        {% if isFiltered %}
            <div class="sk-field">
                <a class="btn" href="{{ url('search-kit/dashboard') }}">{{ "Clear"|t('search-kit') }}</a>
            </div>
        {% endif %}
    </form>

    <nav class="sk-ranges" aria-label="{{ 'Date range'|t('search-kit') }}">
        {% for range in ranges %}
            {% set isActive = range.from == activeFrom and range.to == activeTo %}
            <a class="sk-range{{ isActive ? ' is-active' }}"
               {% if isActive %}aria-current="page"{% endif %}
               href="{{ url('search-kit/dashboard', {
                   indexId: criteria.indexId,
                   siteId: criteria.siteId,
                   dateFrom: range.from,
                   dateTo: range.to,
               }) }}">{{ range.label }}</a>
        {% endfor %}
    </nav>

    {% if unavailable %}
        <div class="pane">
            <p class="error">{{ "Search activity could not be read just now. Everything else in the control panel is unaffected — try again shortly."|t('search-kit') }}</p>
        </div>
    {% endif %}

    {% set periodNote = activeFrom or activeTo
        ? "For the selected dates"|t('search-kit')
        : "For everything recorded so far"|t('search-kit') %}

    {% set searchValues = [] %}
    {% set zeroValues = [] %}
    {% set timeValues = [] %}
    {% set maxSearches = 0 %}
    {% set maxTime = 0 %}
    {% for point in trend %}
        {% set searchValues = searchValues|merge([point.searches]) %}
        {% set zeroValues = zeroValues|merge([point.zeroResults]) %}
        {% set timeValues = timeValues|merge([point.averageTime]) %}
    {% endfor %}
    {% if searchValues|length %}
        {% set maxSearches = max(searchValues) %}
        {% set maxTime = max(timeValues) %}
    {% endif %}

    {% if arranging %}
        <div class="pane sk-arrange-bar">
            <div class="sk-pane-header">
                <h2>{{ "Panels you have put away"|t('search-kit') }}</h2>
                <form method="post" accept-charset="UTF-8">
                    {{ csrfInput() }}
                    {{ actionInput('search-kit/dashboard/reset-layout') }}
                    {{ redirectInput(here) }}
                    <button type="submit" class="btn">{{ "Reset to the default arrangement"|t('search-kit') }}</button>
                </form>
            </div>

            {% if layout.hiddenPanels is empty %}
                <p class="light sk-hint">{{ "Nothing is put away. Drag a panel by its bar to move it, set how many of the four columns it takes, or put it away with ×. This is your own arrangement — nobody else's dashboard changes."|t('search-kit') }}</p>
            {% else %}
                <p class="light sk-hint">{{ "Add one back to the dashboard, or drag a panel by its bar to move it."|t('search-kit') }}</p>
                <div class="sk-chips">
                    {% for key in layout.hiddenPanels %}
                        <form method="post" accept-charset="UTF-8">
                            {{ csrfInput() }}
                            {{ actionInput('search-kit/dashboard/arrange') }}
                            {{ redirectInput(here) }}
                            {{ hiddenInput('panel', key) }}
                            <button type="submit" name="operation" value="show" class="btn add icon">{{ panelNames[key] ?? key }}</button>
                        </form>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div id="sk-panels" class="sk-panels{{ arranging ? ' is-arranging' }}">
        {% for key, span in layout.visiblePanels %}
            {# Without search activity only the health of the indexes can still be read. #}
            {% if not unavailable or key == 'health' %}
                <div class="sk-panel sk-span-{{ span }}" data-panel="{{ key }}">
                    {% if arranging %}
                        <div class="sk-panel-bar">
                            <span class="sk-panel-handle move icon" title="{{ 'Drag to move'|t('search-kit') }}"></span>
                            <span class="sk-panel-name">{{ panelNames[key] ?? key }}</span>

                            <form method="post" accept-charset="UTF-8" class="sk-panel-sizes">
                                {{ csrfInput() }}
                                {{ actionInput('search-kit/dashboard/arrange') }}
                                {{ redirectInput(here) }}
                                {{ hiddenInput('panel', key) }}
                                {{ hiddenInput('operation', 'span') }}
                                {% for width in 1..4 %}
                                    <button type="submit" name="span" value="{{ width }}"
                                            class="sk-size{{ width <= span ? ' is-on' }}"
                                            aria-label="{{ '{width} of 4 columns wide'|t('search-kit', { width: width }) }}"
                                            title="{{ '{width} of 4 columns wide'|t('search-kit', { width: width }) }}"></button>
                                {% endfor %}
                            </form>

                            <form method="post" accept-charset="UTF-8" class="sk-panel-moves">
                                {{ csrfInput() }}
                                {{ actionInput('search-kit/dashboard/arrange') }}
                                {{ redirectInput(here) }}
                                {{ hiddenInput('panel', key) }}
                                <button type="submit" name="operation" value="hide" class="sk-move" aria-label="{{ 'Put this panel away'|t('search-kit') }}" title="{{ 'Put this panel away'|t('search-kit') }}">&times;</button>
                            </form>
                        </div>
                    {% endif %}

                    {% include 'search-kit/dashboard/panels/_' ~ key ~ '.twig' %}
                </div>
            {% endif %}
        {% endfor %}
    </div>

{% endblock %}

{% css %}
    .sk-intro { margin-bottom: 14px; }
    .sk-filters { display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .sk-field { display: flex; flex-direction: column; gap: 5px; }
    .sk-field-label { font-size: 12px; font-weight: 500; color: var(--medium-text-color); }
    .sk-ranges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
    .sk-range { padding: 4px 10px; border-radius: var(--border-radius); font-size: 13px; color: var(--medium-text-color); background: var(--gray-100); }
    .sk-range:hover { background: var(--gray-200); text-decoration: none; }
    .sk-range.is-active { background: var(--gray-700); color: #fff; }
    .sk-section-heading { margin: 26px 0 10px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--medium-text-color); }
    .sk-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 0 0 8px; padding: 0; list-style: none; }
    .sk-stat { padding: 14px 16px; border: 1px solid var(--hairline-color); border-radius: var(--large-border-radius, 8px); background: var(--pane-bg, #fff); }
    .sk-stat-label { display: block; font-size: 12px; font-weight: 500; color: var(--medium-text-color); }
    .sk-stat-value { display: block; margin-top: 6px; font-size: 28px; font-weight: 600; line-height: 1.1; }
    .sk-stat-value small { font-size: 14px; font-weight: 400; color: var(--light-text-color); }
    .sk-stat-note { display: block; margin-top: 4px; font-size: 11px; color: var(--light-text-color); }
    .sk-stat.is-alert .sk-stat-value { color: var(--red-500); }
    .sk-stat.is-good .sk-stat-value { color: var(--green-600); }
    /* Dense, so a panel too wide for what is left of a row is filled in by a narrower one
       instead of leaving a gap nobody can do anything about. */
    .sk-panels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: row dense; gap: 14px; margin-top: 14px; align-items: start; }
    .sk-panel { min-width: 0; }
    /* A panel is only as wide as it was made, so a wide table scrolls rather than covering its neighbour. */
    .sk-panel > .pane { overflow-x: auto; }
    .sk-panel > .pane, .sk-panel > ul { margin: 0; }
    .sk-span-1 { grid-column: span 1; }
    .sk-span-2 { grid-column: span 2; }
    .sk-span-3 { grid-column: span 3; }
    .sk-span-4 { grid-column: span 4; }
    .sk-panels.is-arranging .sk-panel { padding: 8px; border: 1px dashed var(--hairline-color); border-radius: var(--large-border-radius, 8px); background: var(--gray-050, #f8fafc); }
    .sk-panels .sk-panel.velocity-animating, .sk-panels .sk-panel.draggable { z-index: 10; }
    /* The whole bar is what a panel is dragged by, so it is an easy thing to take hold of. */
    .sk-panel-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; padding: 4px 6px; border-radius: var(--border-radius); cursor: move; }
    .sk-panel-bar:hover { background: var(--gray-100); }
    .sk-panel-handle { opacity: 0.6; pointer-events: none; }
    .sk-panel-name { font-size: 12px; font-weight: 500; color: var(--medium-text-color); margin-right: auto; }
    .sk-panel-sizes, .sk-panel-moves, .sk-chips { display: flex; gap: 3px; flex-wrap: wrap; }
    .sk-panel-sizes, .sk-panel-moves { cursor: default; }
    .sk-size { width: 11px; height: 18px; padding: 0; border: 1px solid var(--hairline-color); border-radius: 2px; background: var(--white, #fff); cursor: pointer; }
    .sk-size.is-on { background: var(--gray-500); border-color: var(--gray-500); }
    .sk-move { min-width: 22px; height: 22px; padding: 0 5px; border: 1px solid var(--hairline-color); border-radius: var(--border-radius); background: var(--white, #fff); color: var(--medium-text-color); cursor: pointer; line-height: 1; }
    .sk-move:hover { background: var(--gray-100); }
    .sk-arrange-bar { margin-bottom: 14px; }
    .sk-arrange-bar .sk-pane-header { margin-bottom: 6px; }
    /* Dragging: the panel being carried, and the gap showing where it will land. */
    .sk-panels.is-arranging { user-select: none; }
    .sk-panels.is-arranging .sk-panel-bar:active { cursor: grabbing; }
    /* The space the panel will take: its own columns and its own height, so nothing jumps. */
    .sk-panels.is-arranging .sk-panel.sk-panel-drop { box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0; border: 2px dashed var(--blue-500, #3b82f6); background: rgba(59, 130, 246, 0.07); }
    .sk-panel-drop span { font-size: 12px; font-weight: 500; color: var(--blue-500, #3b82f6); }
    /* The panel being carried, lifted off the grid it came from. */
    body.sk-dragging-panel { overflow-x: hidden; }
    .sk-panel-helper { z-index: 100; overflow: hidden; opacity: 0.95; background: var(--pane-bg, #fff); box-shadow: 0 12px 30px rgba(15, 23, 42, 0.22); border-radius: var(--large-border-radius, 8px); cursor: grabbing; }
    .sk-panel-helper .sk-panel-bar { background: var(--gray-100); }
    .sk-pane-header { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .sk-pane-header h2 { margin: 0; }
    .sk-hint { margin: 2px 0 10px; font-size: 12px; }
    .sk-chart { margin: 10px 0 6px; }
    .sk-chart svg { display: block; width: 100%; height: 180px; overflow: visible; }
    .sk-chart.is-short svg { height: 110px; }
    .sk-chart-grid { stroke: var(--hairline-color); stroke-width: 1; vector-effect: non-scaling-stroke; }
    .sk-chart-area { fill: var(--blue-500, #3b82f6); opacity: 0.12; stroke: none; }
    .sk-chart-line { fill: none; stroke: var(--blue-500, #3b82f6); stroke-width: 2; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
    .sk-chart-line.is-alert { stroke: var(--red-500); }
    .sk-chart-line.is-time { stroke: var(--green-600); }
    .sk-chart-axis { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; color: var(--light-text-color); }
    .sk-legend { display: flex; flex-wrap: wrap; gap: 14px; margin: 8px 0 0; padding: 0; list-style: none; font-size: 12px; color: var(--medium-text-color); }
    .sk-legend-stacked { flex-direction: column; gap: 6px; }
    .sk-legend li { display: flex; align-items: center; gap: 6px; }
    .sk-legend strong { margin-left: auto; color: var(--text-color); }
    .sk-swatch { width: 10px; height: 10px; border-radius: 2px; background: var(--blue-500, #3b82f6); }
    .sk-swatch.is-alert { background: var(--red-500); }
    .sk-swatch.is-good { background: var(--green-600); }
    .sk-swatch.is-muted { background: var(--gray-400); }
    .sk-donut svg { display: block; width: 100%; max-width: 190px; margin: 6px auto 0; }
    .sk-donut-track { fill: none; stroke: var(--gray-200); stroke-width: 14; }
    .sk-donut-value { fill: none; stroke: var(--green-600); stroke-width: 14; stroke-linecap: butt; transform: rotate(-90deg); transform-origin: 60px 60px; }
    .sk-donut-text { fill: var(--text-color); font-size: 22px; font-weight: 600; text-anchor: middle; }
    .sk-donut-caption { fill: var(--light-text-color); font-size: 9px; text-anchor: middle; }
    .sk-data { margin-top: 10px; }
    .sk-data summary { font-size: 12px; color: var(--medium-text-color); cursor: pointer; }
    .sk-data table { margin-top: 8px; }
    .sk-query { display: inline-block; max-width: 18em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
    .sk-panel .zilch { padding: 40px 0; font-size: 16px; }
    @media only screen and (max-width: 1100px) {
        .sk-panels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sk-span-1, .sk-span-2 { grid-column: span 1; }
        .sk-span-3, .sk-span-4 { grid-column: span 2; }
    }
    @media only screen and (max-width: 720px) {
        .sk-panels { grid-template-columns: minmax(0, 1fr); }
        .sk-span-1, .sk-span-2, .sk-span-3, .sk-span-4 { grid-column: span 1; }
    }
{% endcss %}

{% if arranging %}
    {% js %}
        // Craft's own drag sorting, with the panels moving out of the way as it happens.
        (function() {
            var GHOST_WIDTH = 260;
            var GHOST_HEIGHT = 64;
            var GLIDE = 180;
            var EDGE = 6;

            var $grid = $('#sk-panels');
            var $panels = $grid.children('.sk-panel');

            if (!$panels.length || typeof Garnish === 'undefined') {
                return;
            }

            $panels.each(function() {
                $(this).data('span', (this.className.match(/sk-span-(\d)/) || [])[1] || 2);
            });

            // The panel being carried, measured while it is still in the grid.
            var carried = { height: 0, span: 2, name: '' };
            var before = {};

            function positions() {
                var map = {};

                $grid.children('.sk-panel').each(function() {
                    var key = $(this).data('panel');

                    if (key) {
                        map[key] = this.getBoundingClientRect();
                    }
                });

                return map;
            }

            // Every panel slides from where it appears now to where it has just been put.
            function glide() {
                var panels = $grid.children('.sk-panel').toArray();
                var after = {};

                // Measured with nothing part-way, so the place each one is going to is the real one.
                panels.forEach(function(panel) {
                    panel.style.transition = 'none';
                    panel.style.transform = '';
                });

                panels.forEach(function(panel) {
                    if (panel.dataset.panel) {
                        after[panel.dataset.panel] = panel.getBoundingClientRect();
                    }
                });

                // Garnish measures where a panel may be dropped once, at the start. The grid has
                // moved since, so it is measured again now, while nothing is part-way.
                if (sorter && typeof sorter._precalculateMidpoints === 'function') {
                    sorter._precalculateMidpoints();
                }

                // Put back where it looked a moment ago, before anything is drawn.
                panels.forEach(function(panel) {
                    var was = before[panel.dataset.panel];
                    var now = after[panel.dataset.panel];

                    if (!was || !now) {
                        return;
                    }

                    var x = was.left - now.left;
                    var y = was.top - now.top;

                    if (Math.abs(x) >= 1 || Math.abs(y) >= 1) {
                        panel.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
                    }
                });

                requestAnimationFrame(function() {
                    panels.forEach(function(panel) {
                        panel.style.transition = 'transform ' + GLIDE + 'ms cubic-bezier(0.2, 0.8, 0.2, 1)';
                        panel.style.transform = '';
                    });
                });

                before = after;
            }

            function clamp(value, least, most) {
                return Math.min(Math.max(value, least), most);
            }

            function snap() {
                before = positions();
            }

            function settle() {
                $grid.children('.sk-panel').each(function() {
                    this.style.transition = '';
                    this.style.transform = '';
                });
            }

            // Measured on the way down, while the panel is still where it was.
            $grid.on('mousedown', '.sk-panel-bar', function() {
                var $panel = $(this).closest('.sk-panel');

                carried = {
                    height: $panel.outerHeight(),
                    span: $panel.data('span') || 2,
                    name: $panel.find('.sk-panel-name').text(),
                };

                before = positions();
            });

            var watcher = window.MutationObserver ? new MutationObserver(glide) : null;
            var saving;

            function save() {
                clearTimeout(saving);

                // One save for a drag, however many places it passed through on the way.
                saving = setTimeout(function() {
                    var order = $.map($grid.children('.sk-panel').not('.sk-panel-drop'), function(panel) {
                        return $(panel).data('panel');
                    });

                    Craft.sendActionRequest('POST', 'search-kit/dashboard/arrange', {
                        data: { operation: 'order', panels: order },
                    }).catch(function() {
                        Craft.cp.displayError(Craft.t('search-kit', 'Couldn’t save your dashboard arrangement.'));
                    });
                }, 250);
            }

            // Garnish calls these back without itself as `this`, so the sorter is held onto here.
            var sorter = new Garnish.DragSort($panels, {
                handle: '.sk-panel-bar',
                // Buttons in the bar stay buttons: taking hold of one must not start a drag.
                ignoreHandleSelector: 'button, input, select, textarea, a',
                axis: null,
                // 1 is no lag at all: the panel sits under the pointer instead of trailing it.
                helperLagBase: 1,
                // The panel leaves the grid while it is carried, so its place is the one being shown.
                removeDraggee: true,
                collapseDraggees: false,
                // The space it will take, exactly: same columns, same height, so nothing else shifts.
                insertion: function() {
                    return $('<div class="sk-panel sk-panel-drop"><span></span></div>')
                        .addClass('sk-span-' + carried.span)
                        .css('height', carried.height)
                        .find('span').text(carried.name).end();
                },
                onDragStart: function() {
                    // Carried as a small card centred on the pointer. Garnish picks where a panel
                    // lands from the middle of what is being dragged, so a panel-sized helper would
                    // aim half a panel below the pointer, and differently depending on where it was
                    // taken hold of. These four are what that sum is made of.
                    sorter.targetItemWidth = GHOST_WIDTH;
                    sorter.targetItemHeight = GHOST_HEIGHT;
                    sorter.mouseOffsetX = GHOST_WIDTH / 2;
                    sorter.mouseOffsetY = GHOST_HEIGHT / 2;

                    sorter.helpers[0]
                        .addClass('sk-panel-helper')
                        .css({ width: GHOST_WIDTH, height: GHOST_HEIGHT });

                    // Where the card is put, every frame — kept inside the window so a panel is
                    // never carried off the page and nothing is pushed sideways to make room.
                    sorter.getHelperTargetX = function() {
                        return clamp(
                            this.mouseX - this.mouseOffsetX,
                            window.pageXOffset + EDGE,
                            window.pageXOffset + document.documentElement.clientWidth - GHOST_WIDTH - EDGE,
                        );
                    };

                    sorter.getHelperTargetY = function() {
                        return clamp(
                            this.mouseY - this.mouseOffsetY,
                            window.pageYOffset + EDGE,
                            window.pageYOffset + document.documentElement.clientHeight - GHOST_HEIGHT - EDGE,
                        );
                    };

                    // The gap is only right if it was made after the panel was measured.
                    if (sorter.$insertion && sorter.$insertion.length) {
                        sorter.$insertion
                            .css('height', carried.height)
                            .addClass('sk-span-' + carried.span)
                            .find('span').text(carried.name);
                    }

                    $('body').addClass('sk-dragging-panel');

                    // Taken in the capturing phase, which is before Garnish moves anything.
                    document.addEventListener('mousemove', snap, true);

                    if (watcher) {
                        watcher.observe($grid[0], { childList: true });
                    }
                },
                // Kept a frame behind the grid, which is where each panel slides from.
                onSortChange: save,
                onDragStop: function() {
                    $('body').removeClass('sk-dragging-panel');
                    document.removeEventListener('mousemove', snap, true);

                    if (watcher) {
                        watcher.disconnect();
                    }

                    setTimeout(settle, GLIDE + 40);
                    save();
                },
            });
        })();
    {% endjs %}
