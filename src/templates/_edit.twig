{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = isNew ? "New search index"|t('search-kit') : index.name %}
{% set fullPageForm = canManage %}
{% set selectedSubnavItem = 'indexes' %}
{% set crumbs = [{ label: "SearchKit"|t('search-kit'), url: url('search-kit/indexes') }] %}

{% set siteOptions = [{ label: "All sites"|t('search-kit'), value: '' }] %}
{% for site in craft.app.sites.getAllSites() %}
    {% set siteOptions = siteOptions|merge([{ label: site.name, value: site.id }]) %}
{% endfor %}

{% block content %}
    {% if status and status.rebuildRequired %}
        <div class="readable">
            <blockquote class="note warning">
                {{ "This index’s configuration changed since it was last rebuilt, so what the provider holds may no longer match it. Rebuild it from the index list."|t('search-kit') }}
            </blockquote>
        </div>
    {% endif %}

    {{ actionInput('search-kit/indexes/save') }}
    {% if not isNew %}{{ hiddenInput('indexId', index.id) }}{% endif %}
    {{ redirectInput('search-kit/indexes/{id}') }}

    {{ forms.textField({
        first: true,
        label: "Name"|t('search-kit'),
        id: 'name',
        name: 'name',
        value: index.name,
        errors: index.getErrors('name'),
        required: true,
    }) }}

    {{ forms.textField({
        label: "Handle"|t('search-kit'),
        id: 'handle',
        name: 'handle',
        class: 'code',
        value: index.handle,
        errors: index.getErrors('handle'),
        required: true,
        instructions: "How this index is referred to from a search query."|t('search-kit'),
    }) }}

    {{ forms.selectField({
        label: "Provider"|t('search-kit'),
        id: 'provider',
        name: 'provider',
        options: providerOptions,
        value: index.provider,
        errors: index.getErrors('provider'),
        instructions: "Changing this requires a rebuild. Whatever the previous provider holds is left untouched."|t('search-kit'),
    }) }}

    {{ forms.selectField({
        label: "Site"|t('search-kit'),
        id: 'siteId',
        name: 'siteId',
        options: siteOptions,
        value: index.siteId,
        errors: index.getErrors('siteId'),
        instructions: "An index covers one site or every site. A query can narrow that, never widen it. Changing this requires a rebuild."|t('search-kit'),
    }) }}

    {{ forms.lightswitchField({
        label: "Enabled"|t('search-kit'),
        id: 'enabled',
        name: 'enabled',
        on: index.enabled,
    }) }}

    <hr>

    <h2>{{ "Searchable fields"|t('search-kit') }}</h2>
    <p>{{ "Which element types this index covers, and how heavily each field counts. Weights are stored for providers that can rank by them."|t('search-kit') }}</p>

    {% if index.getErrors('fields') %}
        <ul class="errors">{% for error in index.getErrors('fields') %}<li>{{ error }}</li>{% endfor %}</ul>
    {% endif %}

    {% for group in elementTypeGroups %}
        {% set handleOptions = [] %}
        {% for handle in group.handles %}
            {% set handleOptions = handleOptions|merge([{ label: handle, value: handle }]) %}
        {% endfor %}

        {% set rows = [] %}
        {% for field in index.getFields()|filter(f => f.elementType == group.type) %}
            {% set rows = rows|merge([{ handle: field.handle, weight: field.weight, enabled: field.enabled }]) %}
        {% endfor %}

        {{ hiddenInput('elementTypes[' ~ loop.index0 ~ ']', group.type) }}

        {{ forms.editableTableField({
            label: group.label,
            instructions: handleOptions is empty ? "No searchable fields are available for this element type."|t('search-kit') : null,
            id: 'fields-' ~ loop.index0,
            name: 'fields[' ~ loop.index0 ~ ']',
            cols: {
                handle: { heading: "Field"|t('search-kit'), type: 'select', options: handleOptions },
                weight: { heading: "Weight"|t('search-kit'), type: 'number', min: 0, max: 1000, small: true },
                enabled: { heading: "Enabled"|t('search-kit'), type: 'lightswitch' },
            },
            rows: rows,
            addRowLabel: "Add a field"|t('search-kit'),
            static: not canManage or handleOptions is empty,
        }) }}
    {% endfor %}

    <hr>

    <h2>{{ "Search behaviour"|t('search-kit') }}</h2>
    <p>{{ "How this index treats the text it is searched with. None of this changes what is indexed, so changing it never needs a rebuild."|t('search-kit') }}</p>

    {% if index.getErrors('searchSettings') %}
        <ul class="errors">{% for error in index.getErrors('searchSettings') %}<li>{{ error }}</li>{% endfor %}</ul>
    {% endif %}

    {% set behaviour = index.getSearchSettings() %}

    {{ forms.lightswitchField({
        label: "Search operators"|t('search-kit'),
        id: 'searchSettings-operators',
        name: 'searchSettings[operators]',
        on: behaviour.operators,
        instructions: 'Read <code>"phrases"</code>, <code>-exclusions</code>, <code>OR</code> and <code>*</code> in what is typed. Off, every word is searched for as written.'|t('search-kit'),
    }) }}

    {{ forms.selectField({
        label: "Partial matching"|t('search-kit'),
        id: 'searchSettings-partialMatching',
        name: 'searchSettings[partialMatching]',
        options: partialMatchOptions,
        value: behaviour.partialMatching.value,
        instructions: "How much of a word a term has to cover when nothing was typed to say otherwise."|t('search-kit'),
    }) }}

    {{ forms.textField({
        label: "Shortest partial match"|t('search-kit'),
        id: 'searchSettings-minPartialLength',
        name: 'searchSettings[minPartialLength]',
        type: 'number',
        min: 1,
        max: 20,
        size: 4,
        value: behaviour.minPartialLength,
        instructions: "Shorter terms are matched whole, so a two-letter word does not match everything."|t('search-kit'),
    }) }}

    {{ forms.lightswitchField({
        label: "Stop words"|t('search-kit'),
        id: 'searchSettings-stopWords',
        name: 'searchSettings[stopWords]',
        on: behaviour.stopWords,
        instructions: "Drop words too common to narrow anything down. A query made only of them is left alone."|t('search-kit'),
    }) }}

    {{ forms.textField({
        label: "Extra stop words"|t('search-kit'),
        id: 'searchSettings-customStopWords',
        name: 'searchSettings[customStopWords]',
        value: behaviour.customStopWords|join(', '),
        instructions: "Comma separated, on top of the built-in list."|t('search-kit'),
    }) }}

    {{ forms.lightswitchField({
        label: "Synonyms"|t('search-kit'),
        id: 'searchSettings-synonyms',
        name: 'searchSettings[synonyms]',
        on: behaviour.synonyms,
        instructions: "Apply the synonyms configured for this index."|t('search-kit'),
    }) }}

    {{ forms.lightswitchField({
        label: "Typo tolerance"|t('search-kit'),
        id: 'searchSettings-typoTolerance',
        name: 'searchSettings[typoTolerance]',
        on: behaviour.typoTolerance,
        instructions: "Retry a search that found nothing against the words the index holds."|t('search-kit'),
    }) }}

    {{ forms.textField({
        label: "Shortest word corrected"|t('search-kit'),
        id: 'searchSettings-typoMinLength',
        name: 'searchSettings[typoMinLength]',
        type: 'number',
        min: 1,
        max: 20,
        size: 4,
        value: behaviour.typoMinLength,
    }) }}

    {{ forms.textField({
        label: "Edits allowed"|t('search-kit'),
        id: 'searchSettings-typoMaxDistance',
        name: 'searchSettings[typoMaxDistance]',
        type: 'number',
        min: 1,
        max: 2,
        size: 4,
        value: behaviour.typoMaxDistance,
        instructions: "How far a correction may be from what was typed, counted in single-character edits."|t('search-kit'),
    }) }}

    {{ forms.lightswitchField({
        label: "Suggestions"|t('search-kit'),
        id: 'searchSettings-suggestions',
        name: 'searchSettings[suggestions]',
        on: behaviour.suggestions,
        instructions: "Offer something else to try when a search finds nothing."|t('search-kit'),
    }) }}

    {{ forms.textField({
        label: "Suggestions offered"|t('search-kit'),
        id: 'searchSettings-suggestionLimit',
        name: 'searchSettings[suggestionLimit]',
        type: 'number',
        min: 1,
        max: 25,
        size: 4,
        value: behaviour.suggestionLimit,
    }) }}

    <hr>

    <h2>{{ "Search activity"|t('search-kit') }}</h2>
    <p>{{ "What is recorded about searches of this index. Nothing recorded identifies who searched."|t('search-kit') }}</p>

    {% if index.getErrors('analyticsSettings') %}
        <ul class="errors">{% for error in index.getErrors('analyticsSettings') %}<li>{{ error }}</li>{% endfor %}</ul>
    {% endif %}

    {% set activity = index.getAnalyticsSettings() %}

    {{ forms.lightswitchField({
        label: "Record searches"|t('search-kit'),
        id: 'analyticsSettings-enabled',
        name: 'analyticsSettings[enabled]',
        on: activity.enabled,
        instructions: "Keep what was searched for, how many results came back and how long it took."|t('search-kit'),
    }) }}

    {{ forms.lightswitchField({
        label: "Record opened results"|t('search-kit'),
        id: 'analyticsSettings-trackClicks',
        name: 'analyticsSettings[trackClicks]',
        on: activity.trackClicks,
        instructions: "Associate a result someone opened with the search that found it."|t('search-kit'),
    }) }}

    {{ forms.textField({
        label: "Kept for"|t('search-kit'),
        id: 'analyticsSettings-retentionDays',
        name: 'analyticsSettings[retentionDays]',
        type: 'number',
        min: 1,
        max: 3650,
        size: 5,
        value: activity.retentionDays,
        instructions: "Days. Anything older is deleted when Craft next tidies up."|t('search-kit'),
    }) }}

    {{ forms.textField({
        label: "Slow search"|t('search-kit'),
        id: 'analyticsSettings-slowThreshold',
        name: 'analyticsSettings[slowThreshold]',
        type: 'number',
        min: 1,
        max: 60000,
        size: 6,
        value: activity.slowThreshold,
        instructions: "Milliseconds beyond which a search counts as slow."|t('search-kit'),
    }) }}

    {% if not isNew %}
        <hr>

        <h2>{{ "Index status"|t('search-kit') }}</h2>
        <ul>
            <li>{{ "Pending operations"|t('search-kit') }}: {{ status.pending }}</li>
            <li>{{ "Failed operations"|t('search-kit') }}: {{ status.failed }}</li>
            <li>{{ "Last indexed"|t('search-kit') }}: {{ index.dateLastIndexed ? index.dateLastIndexed|datetime('short') : "Never"|t('search-kit') }}</li>
            <li>{{ "Rebuild required"|t('search-kit') }}: {{ status.rebuildRequired ? "Yes"|t('search-kit') : "No"|t('search-kit') }}</li>
            <li>{{ "Provider can index"|t('search-kit') }}: {{ status.canIndex ? "Yes"|t('search-kit') : "No"|t('search-kit') }}</li>
            <li>{{ "Provider can delete"|t('search-kit') }}: {{ status.canDelete ? "Yes"|t('search-kit') : "No"|t('search-kit') }}</li>
            <li>{{ "Words held for suggestions"|t('search-kit') }}: {{ termCount }}</li>
        </ul>

        {% if failures %}
            <h3>{{ "Failed operations"|t('search-kit') }}</h3>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col">{{ "Element"|t('search-kit') }}</th>
                        <th scope="col">{{ "Operation"|t('search-kit') }}</th>
                        <th scope="col">{{ "Attempts"|t('search-kit') }}</th>
                        <th scope="col">{{ "Error"|t('search-kit') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for failure in failures %}
                        <tr>
                            <th scope="row">#{{ failure.elementId }} ({{ failure.elementType|split('\\')|last }})</th>
                            <td>{{ failure.operation.value }}</td>
                            <td>{{ failure.attempts }}</td>
                            <td>{{ failure.error }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <p>{{ "Rebuild and retry are run from the index list."|t('search-kit') }}</p>
    {% endif %}
{% endblock %}
